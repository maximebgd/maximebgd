# Copy this file to .env and fill in your values.
# .env is git-ignored so your token never gets pushed.

# GitHub fine-grained personal access token.
# Required permissions (read-only, All repositories):
#   Repository: Commit statuses (read), Contents (read), Metadata (read)
# Create one at: https://github.com/settings/tokens?type=beta
ACCESS_TOKEN=ghp_your_token_here

# Your GitHub username
USER_NAME=maximebgd
